---
import { icons } from '~/lib/icons';

interface Props {
  name: string;
  size?: number | string;
  /** nhãn đọc màn hình; bỏ trống = icon trang trí */
  label?: string;
  class?: string;
  [key: string]: any;
}
const { name, size = 24, label, class: cls, ...rest } = Astro.props;
const Svg = icons[name];
if (!Svg) throw new Error(`Icon không tồn tại: "${name}" (xem src/icons/)`);
const small = typeof size === 'number' && size < 20;
---
<Svg
  width={size}
  height={size}
  class:list={['icon', small && 'icon--sm', cls]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  {...rest}
/>
