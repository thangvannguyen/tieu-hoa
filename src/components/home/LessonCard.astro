---
import Icon from '~/components/ui/Icon.astro';
import { url } from '~/lib/url';
import { lessonLabel, readingMinutes, chapterOf, type Lesson } from '~/lib/lessons';
interface Props { lesson: Lesson }
const { lesson } = Astro.props;
const c = chapterOf(lesson);
---
<a class="lc" href={url(`/bai/${lesson.id}/`)} data-hue={c.hue} data-lesson={lesson.id}>
  <span class="lc__ic"><Icon name={lesson.data.icon} size={36} /></span>
  <span class="lc__k">{lessonLabel(lesson)} · {readingMinutes(lesson.body)} phút</span>
  <span class="lc__t">{lesson.data.title}</span>
  <span class="lc__s">{lesson.data.summary}</span>
  <span class="lc__done" aria-hidden="true"><Icon name="dung" size={22} /> Đã học</span>
</a>
<style>
  .lc { position: relative; height: 100%; display: grid; align-content: start; gap: 0.3rem; padding: 1rem 1.1rem; border-radius: var(--radius-lg); background: var(--surface); border: 2px solid var(--ink); box-shadow: 0 4px 0 var(--ink); color: var(--ink); text-decoration: none; transition: transform 0.12s, box-shadow 0.12s; }
  .lc:hover { transform: translateY(-3px); box-shadow: 0 7px 0 var(--ink); }
  .lc__ic { display: grid; place-items: center; width: 58px; height: 58px; border-radius: 18px; background: var(--h-fill); --ic-fill: var(--surface); margin-bottom: 0.2rem; }
  .lc__k { font-size: 0.76rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: var(--h-ink); }
  .lc__t { font-family: var(--font-head); font-weight: 900; font-size: 1.1rem; line-height: 1.3; }
  .lc__s { font-size: 0.9rem; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .lc__done { display: none; position: absolute; top: 0.8rem; right: 0.8rem; align-items: center; gap: 0.25rem; padding: 0.15rem 0.6rem 0.15rem 0.3rem; border-radius: 999px; background: var(--sage-fill); color: var(--sage-ink); font-size: 0.78rem; font-weight: 800; --ic-fill: var(--surface); }
  :global(.lc.is-done) .lc__done { display: inline-flex; }
</style>
