---
/**
 * Video YouTube dạng "bấm mới tải" (không tải gì từ YouTube trước khi bấm).
 * Ảnh bìa đã tải sẵn về src/assets/youtube/. Shorts hiển thị khung dọc 9:16.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '~/components/ui/Icon.astro';
import yt from '~/data/youtube.json';

interface Props { id: string; title?: string; note?: string }
const { id, title, note } = Astro.props;
const meta = (yt as Record<string, { title: string; shorts: boolean }>)[id];
if (!meta) throw new Error(`Chưa có dữ liệu YouTube cho ${id} — chạy scripts/fetch_youtube.py`);
const thumbs = import.meta.glob<{ default: ImageMetadata }>('/src/assets/youtube/*.jpg', { eager: true });
const thumb = thumbs[`/src/assets/youtube/${id}.jpg`]?.default;
const label = title ?? meta.title;
const watch = meta.shorts ? `https://www.youtube.com/shorts/${id}` : `https://www.youtube.com/watch?v=${id}`;
---
<yt-embed class:list={['yt', meta.shorts && 'yt--shorts']} data-id={id} data-title={label}>
  <div class="yt__frame">
    {thumb && <Image src={thumb} alt="" width={480} quality={75} loading="lazy" class="yt__thumb" />}
    <button class="yt__btn" type="button" aria-label={`Phát video: ${label}`}>
      <Icon name="play" size={56} />
    </button>
  </div>
  <p class="yt__cap">
    <Icon name="video" size={20} />
    <span><strong>{label}</strong>{note && <> — {note}</>}</span>
    <a href={watch} target="_blank" rel="noopener">Mở trên YouTube</a>
  </p>
</yt-embed>

<script>
  class YtEmbed extends HTMLElement {
    connectedCallback() {
      const btn = this.querySelector<HTMLButtonElement>('.yt__btn');
      btn?.addEventListener('click', () => {
        const frame = this.querySelector('.yt__frame')!;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${this.dataset.id}?autoplay=1&rel=0`;
        iframe.title = this.dataset.title ?? 'Video YouTube';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        frame.replaceChildren(iframe);
        iframe.focus();
      }, { once: true });
    }
  }
  customElements.define('yt-embed', YtEmbed);
</script>

<style>
  .yt { display: block; margin: 1.5rem 0; }
  .yt__frame {
    position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden;
    background: var(--ink); border: 2px solid var(--edge); box-shadow: 0 4px 0 var(--edge-shadow);
  }
  .yt--shorts .yt__frame { aspect-ratio: 9 / 16; max-width: 320px; }
  .yt__frame :global(img), .yt__frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .yt__btn {
    position: absolute; inset: 0; display: grid; place-items: center; border: 0; cursor: pointer;
    background: linear-gradient(transparent 40%, rgb(0 0 0 / 0.35)); color: #fff; --ic-fill: #e8786d;
  }
  .yt__btn :global(.icon) { filter: drop-shadow(0 3px 0 rgb(0 0 0 / 0.35)); transition: transform 0.15s; }
  .yt__btn:hover :global(.icon) { transform: scale(1.08); }
  .yt__cap { display: flex; flex-wrap: wrap; gap: 0.4rem 0.6rem; align-items: center; margin: 0.6rem 0 0; font-size: 0.95rem; color: var(--ink-2); }
  .yt__cap a { margin-left: auto; font-size: 0.88rem; }
</style>
