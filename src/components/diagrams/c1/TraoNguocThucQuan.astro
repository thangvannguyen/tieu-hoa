---
/** Minh họa vẽ tay: trào ngược dạ dày thực quản (GERD) — theo định nghĩa trong bản tin #03; tên “cơ thắt thực quản dưới (LES)” theo bản tin #13. */
import Diagram from '../primitives/Diagram.astro';
import { url } from '~/lib/url';
const STOMACH = 'M13 2v4.2C8.6 6.6 4.2 9.6 4.2 14.2c0 4 3.2 6.6 7.2 6.6 3.4 0 5.6-1.6 7.2-3.8l2.8.6v-4.6l-2.6-.4c-2.2-.8-3.2-2.4-3.2-5V2';
const DROP = 'M0 -7c3.4 4.2 5 6.8 5 9a5 5 0 0 1-10 0c0-2.2 1.6-4.8 5-9z';
---
<Diagram
  title="Trào ngược dạ dày thực quản (GERD) là gì?"
  icon="thuc-quan"
  hue="dao"
  kicker="Minh họa"
  caption="Mũi tên đỏ: dịch tiêu hóa có tính axit từ dạ dày thường xuyên trào ngược lên thực quản — nơi dịch này có thể gây kích ứng hoặc viêm niêm mạc."
  from={['03-dinh-duong-phong-viem-loet-trao-nguoc', '13-dinh-duong-trao-nguoc']}
>
  <div class="tnq">
    <svg viewBox="0 0 360 320" role="img" aria-label="Thực quản là ống nối từ miệng xuống dạ dày. Dịch tiêu hóa có tính axit từ dạ dày trào ngược lên thực quản (mũi tên đi lên), gây kích ứng hoặc viêm niêm mạc thực quản. Chỗ nối thực quản với dạ dày là cơ thắt thực quản dưới (LES).">
      <!-- bóng -->
      <rect class="tnq__shadow" x="164" y="52" width="26" height="74" rx="4"></rect>
      <path class="tnq__shadow" transform="translate(34 104) scale(10)" d={STOMACH}></path>

      <!-- thực quản -->
      <rect class="tnq__eso" x="160" y="48" width="26" height="78"></rect>
      <path class="tnq__wall" d="M160 48v78M186 48v78"></path>
      <ellipse class="tnq__mouth" cx="173" cy="48" rx="13" ry="5"></ellipse>
      <path class="tnq__thin" d="M173 22v14"></path>
      <path class="tnq__thin" d="M168 31l5 6 5-6"></path>
      <text x="173" y="16" class="tnq__lbl tnq__lbl--soft" text-anchor="middle">từ miệng</text>
      <text x="148" y="114" class="tnq__name" text-anchor="end">thực quản</text>

      <!-- dạ dày -->
      <path class="tnq__gut" transform="translate(30 100) scale(10)" d={STOMACH}></path>
      <circle class="tnq__ink" cx="114" cy="230" r="3.4"></circle>
      <circle class="tnq__ink" cx="140" cy="230" r="3.4"></circle>
      <path class="tnq__line" d="M121 245c3-4 9-4 12 0"></path>
      <ellipse class="tnq__blush" cx="103" cy="241" rx="6" ry="3.4"></ellipse>
      <ellipse class="tnq__blush" cx="151" cy="241" rx="6" ry="3.4"></ellipse>
      <path class="tnq__sweat" transform="translate(98 214) scale(0.8)" d={DROP}></path>
      <text x="84" y="302" class="tnq__name" text-anchor="end">dạ dày</text>

      <!-- dịch tiêu hóa (axit) trong dạ dày -->
      <path class="tnq__acid" transform="translate(186 262)" d={DROP}></path>
      <path class="tnq__acid" transform="translate(206 246) scale(0.8)" d={DROP}></path>
      <path class="tnq__acid" transform="translate(166 284) scale(0.7)" d={DROP}></path>

      <!-- cơ thắt thực quản dưới (LES) -->
      <rect class="tnq__les" x="154" y="142" width="38" height="11" rx="5.5"></rect>
      <text x="146" y="140" class="tnq__lbl" text-anchor="end">cơ thắt thực quản</text>
      <text x="146" y="158" class="tnq__lbl" text-anchor="end">dưới (LES)</text>

      <!-- trào ngược: mũi tên lượn sóng đi lên -->
      <path class="tnq__reflux" d="M173 214q-8-7 0-14t0-14 0-14 0-14 0-14 0-14 0-14 0-14 0-14 0-14"></path>
      <path class="tnq__reflux-head" d="M164 80l9-11 9 11"></path>
      <path class="tnq__acid" transform="translate(178 118) scale(0.65)" d={DROP}></path>
      <path class="tnq__acid" transform="translate(168 176) scale(0.65)" d={DROP}></path>
      <text x="208" y="172" class="tnq__lbl tnq__lbl--do">dịch tiêu hóa</text>
      <text x="208" y="190" class="tnq__lbl tnq__lbl--do">trào ngược</text>

      <!-- niêm mạc thực quản bị kích ứng -->
      <path class="tnq__sore" d="M164 58v52M182 58v52"></path>
      <path class="tnq__spark" d="M152 62l-9-4M152 72h-10M152 82l-9 4M194 62l9-4M194 72h10M194 82l9 4"></path>
      <text x="206" y="70" class="tnq__lbl tnq__lbl--do">kích ứng hoặc viêm</text>
      <text x="206" y="88" class="tnq__lbl tnq__lbl--do">niêm mạc thực quản</text>
    </svg>
    <ul class="tnq__legend">
      <li><span class="tnq__sw tnq__sw--eso"></span><span><strong>Thực quản</strong> — ống nối từ miệng xuống dạ dày</span></li>
      <li><span class="tnq__sw tnq__sw--reflux"></span><span><strong>Dịch tiêu hóa trào ngược</strong> — dịch tiêu hóa từ dạ dày thường xuyên trào ngược lên thực quản</span></li>
      <li><span class="tnq__sw tnq__sw--sore"></span><span><strong>Kích ứng hoặc viêm niêm mạc thực quản</strong> — do có tính axit nên dịch này có thể gây kích ứng hoặc viêm niêm mạc thực quản</span></li>
      <li><span class="tnq__sw tnq__sw--les"></span><span><strong>Cơ thắt thực quản dưới (LES)</strong> — tên gọi được nhắc đến trong <a href={url('/bai/13-dinh-duong-trao-nguoc/')}>bản tin #13</a></span></li>
    </ul>
  </div>
</Diagram>

<style>
  .tnq { display: grid; gap: 1rem; align-items: center; }
  @container (min-width: 620px) { .tnq { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); } }
  .tnq svg { width: 100%; max-width: 420px; margin: 0 auto; display: block; overflow: visible; }
  .tnq__shadow { fill: var(--line); stroke: none; }
  .tnq__eso { fill: var(--hong-fill); stroke: none; }
  .tnq__wall { fill: none; stroke: var(--ink); stroke-width: 3.2; stroke-linecap: round; }
  .tnq__mouth { fill: var(--surface); stroke: var(--ink); stroke-width: 3; }
  .tnq__thin { fill: none; stroke: var(--ink-3); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .tnq__gut { fill: var(--dao-fill); stroke: var(--ink); stroke-width: 0.32; stroke-linejoin: round; stroke-linecap: round; }
  .tnq__line { fill: none; stroke: var(--ink); stroke-width: 3; stroke-linecap: round; }
  .tnq__ink { fill: var(--ink); }
  .tnq__blush { fill: var(--cheek); opacity: 0.8; }
  .tnq__sweat { fill: var(--lav-fill); stroke: var(--ink); stroke-width: 2.5; }
  .tnq__acid { fill: var(--bo); stroke: var(--ink); stroke-width: 2.4; stroke-linejoin: round; }
  .tnq__les { fill: var(--lav); stroke: var(--ink); stroke-width: 2.6; }
  .tnq__reflux { fill: none; stroke: var(--do); stroke-width: 4.5; stroke-linecap: round; stroke-linejoin: round; }
  .tnq__reflux-head { fill: none; stroke: var(--do); stroke-width: 4.5; stroke-linecap: round; stroke-linejoin: round; }
  .tnq__sore { fill: none; stroke: var(--do); stroke-width: 3; stroke-dasharray: 6 5; stroke-linecap: round; }
  .tnq__spark { fill: none; stroke: var(--do); stroke-width: 3; stroke-linecap: round; }
  .tnq__name { font-family: var(--font-head); font-weight: 900; font-size: 16px; fill: var(--ink); }
  .tnq__lbl { font-family: var(--font-head); font-weight: 800; font-size: 14px; fill: var(--ink); }
  .tnq__lbl--soft { fill: var(--ink-2); }
  .tnq__lbl--do { fill: var(--do-ink); }
  .tnq__legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; font-size: 0.93rem; }
  .tnq__legend li { display: grid; grid-template-columns: auto 1fr; gap: 0.55rem; align-items: start; margin: 0; padding: 0.5rem 0.7rem; border-radius: 12px; background: var(--surface); }
  .tnq__sw { width: 22px; height: 22px; margin-top: 0.1rem; border-radius: 7px; border: 2px solid var(--edge); }
  .tnq__sw--eso { background: var(--hong-fill); }
  .tnq__sw--reflux { background: var(--do); }
  .tnq__sw--sore { background: repeating-linear-gradient(90deg, var(--do) 0 4px, var(--surface) 4px 8px); }
  .tnq__sw--les { background: var(--lav); }
</style>
