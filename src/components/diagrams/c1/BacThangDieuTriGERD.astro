---
/**
 * Các bậc quản lý triệu chứng GERD theo mức độ (theo bản tin #03).
 * Ghi chú: Layers shape="stairs" vẽ phần tử đầu tiên hẹp nhất ở TRÊN cùng, nên liệt kê từ bậc cao (nặng) xuống bậc nền.
 */
import Diagram from '../primitives/Diagram.astro';
import Layers from '../primitives/Layers.astro';
---
<Diagram
  title="Quản lý triệu chứng GERD: từ nhẹ đến nặng"
  kicker="Sơ đồ"
  icon="cau-thang"
  hue="lav"
  caption="Phần lớn mọi người có thể quản lý các triệu chứng khó chịu của GERD bằng cách thay đổi lối sống hoặc sử dụng các loại thuốc không cần kê đơn mua tại nhà thuốc. Tuy nhiên, trong những trường hợp nặng hơn, bệnh nhân có thể cần tới bác sĩ để được kê đơn thuốc mạnh hơn hoặc thậm chí cần phẫu thuật để giảm bớt các triệu chứng."
  from={['03-dinh-duong-phong-viem-loet-trao-nguoc']}
>
  <Layers
    shape="stairs"
    baseLabel="Bản tin này tập trung ở bậc nền: phòng bệnh và hỗ trợ điều trị bằng các phương pháp không dùng thuốc."
    layers={[
      { icon: 'canh-bao', hue: 'do', title: 'Thậm chí', text: 'Cần phẫu thuật để giảm bớt các triệu chứng' },
      { icon: 'bac-si', hue: 'bo', title: 'Trường hợp nặng hơn', text: 'Cần tới bác sĩ để được kê đơn thuốc mạnh hơn' },
      { icon: 'nguoi', hue: 'sage', title: 'Phần lớn mọi người', text: 'Thay đổi lối sống hoặc sử dụng các loại thuốc không cần kê đơn mua tại nhà thuốc' },
    ]}
  />
</Diagram>
