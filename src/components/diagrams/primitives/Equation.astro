---
/** A + B = C — dùng cho Probiotic + Prebiotic = Synbiotic. ops: dấu giữa các vế. */
import Card from './Card.astro';
import type { Node } from './types';
interface Props { terms: Node[]; ops?: string[] }
const { terms, ops = terms.map((_, i) => (i === terms.length - 2 ? '=' : '+')) } = Astro.props;
---
<div class="eq" style={`--n:${terms.length}`}>
  {terms.map((t, i) => (
    <>
      <Card node={t} variant={i === terms.length - 1 ? 'fill' : 'default'} class="eq__term" />
      {i < terms.length - 1 && <span class="eq__op" aria-hidden="true">{ops[i]}</span>}
    </>
  ))}
</div>
<style>
  .eq { display: grid; gap: 0.5rem; justify-items: stretch; }
  .eq__op { justify-self: center; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--ink); color: var(--bg); font-family: var(--font-head); font-weight: 900; font-size: 1.4rem; line-height: 1; }
  @container (min-width: 620px) {
    .eq { grid-template-columns: 1fr auto 1fr auto 1fr; align-items: stretch; gap: 0.6rem; }
    .eq__op { align-self: center; }
    .eq :global(.eq__term) { height: 100%; }
  }
</style>
