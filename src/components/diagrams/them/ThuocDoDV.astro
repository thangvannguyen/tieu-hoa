---
/**
 * Thước đo %DV (bài thêm BT02): dưới 5% là thấp, trên 20% là cao.
 * Hai đồng hồ: dưỡng chất có lợi → chọn %DV cao; chất nên hạn chế → chọn %DV thấp.
 * Thang chia 3 cung bằng nhau (thấp · giữa · cao) cho dễ nhìn — không theo tỉ lệ thật.
 */
import Diagram from '../primitives/Diagram.astro';
import Icon from '~/components/ui/Icon.astro';
import type { Hue } from '~/lib/types';

const C = { x: 110, y: 118 };
const R = 78;
const pt = (deg: number, r = R) => {
  const a = (deg * Math.PI) / 180;
  return `${(C.x + r * Math.cos(a)).toFixed(1)} ${(C.y - r * Math.sin(a)).toFixed(1)}`;
};
const arc = (from: number, to: number) => `M${pt(from)} A${R} ${R} 0 0 1 ${pt(to)}`;
const ZONES = { thap: arc(180, 120), giua: arc(120, 60), cao: arc(60, 0) };
const FULL = arc(180, 0);

interface Gauge {
  hue: Hue;
  title: string;
  target: 'thap' | 'cao';
  other: 'neutral' | 'do';
  items: { icon: string; text: string }[];
  aria: string;
}
const gauges: Gauge[] = [
  {
    hue: 'sage', title: 'Dưỡng chất có lợi → chọn %DV cao', target: 'cao', other: 'neutral',
    items: [{ icon: 'chat-xo', text: 'chất xơ' }, { icon: 'sparkle', text: 'vitamin' }, { icon: 'sparkle', text: 'khoáng chất' }],
    aria: 'Đồng hồ %DV, kim chỉ vào vùng cao (trên 20%): với dưỡng chất có lợi, chọn thực phẩm có %DV cao.',
  },
  {
    hue: 'do', title: 'Chất nên hạn chế → chọn %DV thấp', target: 'thap', other: 'do',
    items: [{ icon: 'duong', text: 'đường' }, { icon: 'muoi', text: 'muối' }, { icon: 'dau-an', text: 'chất béo bão hòa' }],
    aria: 'Đồng hồ %DV, kim chỉ vào vùng thấp (dưới 5%): với những chất nên hạn chế, chọn thực phẩm có %DV thấp.',
  },
];
const needleTip = (t: 'thap' | 'cao') => pt(t === 'cao' ? 30 : 150, 56);
const sep = (deg: number) => `M${pt(deg, 64)} L${pt(deg, 92)}`;
---
<Diagram
  title="Thước đo %DV: thấp hay cao?"
  icon="bieu-do"
  hue="sage"
  kicker="Sơ đồ"
  caption="Thang chia đều cho dễ nhìn, không theo tỉ lệ thật."
  from={['bt-02-doc-nhan-thuc-pham']}
>
  <p class="dv__scale">
    <span data-hue="lav"><strong>dưới 5%</strong> = thấp</span>
    <span data-hue="bo"><strong>trên 20%</strong> = cao</span>
  </p>
  <div class="dv">
    {gauges.map((g) => (
      <section class="dv__card" data-hue={g.hue}>
        <svg viewBox="0 0 220 150" role="img" aria-label={g.aria}>
          <path class="dv-o" d={FULL}></path>
          <path class:list={['dv-z', g.target === 'thap' ? 'dv-z--on' : g.other === 'do' ? 'dv-z--bad' : 'dv-z--off']} d={ZONES.thap}></path>
          <path class="dv-z dv-z--mid" d={ZONES.giua}></path>
          <path class:list={['dv-z', g.target === 'cao' ? 'dv-z--on' : g.other === 'do' ? 'dv-z--bad' : 'dv-z--off']} d={ZONES.cao}></path>
          <path class="dv-sep" d={sep(120)}></path>
          <path class="dv-sep" d={sep(60)}></path>
          <text class="dv-tick" x="56" y="30" text-anchor="middle">5%</text>
          <text class="dv-tick" x="164" y="30" text-anchor="middle">20%</text>
          <text class:list={['dv-zl', g.target === 'thap' && 'dv-zl--on']} x="32" y="144" text-anchor="middle">thấp</text>
          <text class:list={['dv-zl', g.target === 'cao' && 'dv-zl--on']} x="188" y="144" text-anchor="middle">cao</text>
          <!-- kim -->
          <path class="dv-needle-o" d={`M${C.x} ${C.y} L${needleTip(g.target)}`}></path>
          <path class="dv-needle" d={`M${C.x} ${C.y} L${needleTip(g.target)}`}></path>
          <!-- tâm mặt cười -->
          <circle class="dv-hub" cx={C.x} cy={C.y} r="21"></circle>
          <circle class="dv-ink" cx={C.x - 7} cy={C.y - 2} r="2.8"></circle>
          <circle class="dv-ink" cx={C.x + 7} cy={C.y - 2} r="2.8"></circle>
          <path class="dv-line" d={`M${C.x - 3.5} ${C.y + 5} c2.2 2.6 4.8 2.6 7 0`}></path>
          <ellipse class="dv-blush" cx={C.x - 13} cy={C.y + 5} rx="4" ry="2.4"></ellipse>
          <ellipse class="dv-blush" cx={C.x + 13} cy={C.y + 5} rx="4" ry="2.4"></ellipse>
        </svg>
        <p class="dv__t">{g.title}</p>
        <ul class="dv__list">
          {g.items.map((it) => <li><Icon name={it.icon} size={22} /> {it.text}</li>)}
        </ul>
      </section>
    ))}
  </div>
</Diagram>

<style>
  .dv__scale { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 0.8rem !important; }
  .dv__scale span { padding: 0.15rem 0.7rem; border-radius: 999px; background: var(--h-fill); border: 2px solid var(--h); font-size: 0.88rem; }
  .dv__scale strong { color: var(--h-ink); }
  .dv { display: grid; gap: 0.9rem; }
  @container (min-width: 540px) { .dv { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .dv__card { display: grid; align-content: start; gap: 0.5rem; padding: 0.8rem 0.9rem 0.9rem; border-radius: 18px; background: var(--surface); border: 2px solid var(--ink); box-shadow: 0 3px 0 var(--ink); }
  .dv__card > svg { width: 100%; max-width: 280px; margin: 0 auto; display: block; overflow: visible; }
  .dv__t { font-family: var(--font-head); font-weight: 900; font-size: 1.02rem; line-height: 1.3; color: var(--h-ink); text-align: center; }
  .dv__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.35rem; }
  .dv__list li { display: inline-flex; align-items: center; gap: 0.3rem; margin: 0; padding: 0.2rem 0.65rem 0.2rem 0.35rem; border-radius: 999px; background: var(--h-fill); font-size: 0.9rem; --ic-fill: var(--surface); }

  .dv-o { fill: none; stroke: var(--ink); stroke-width: 31; }
  .dv-z { fill: none; stroke-width: 24; }
  .dv-z--on { stroke: var(--sage); }
  .dv-z--bad { stroke: var(--do); }
  .dv-z--off { stroke: var(--line-2); }
  .dv-z--mid { stroke: var(--line); }
  .dv-sep { stroke: var(--ink); stroke-width: 3; }
  .dv-tick { font-family: var(--font-head); font-weight: 900; font-size: 14px; fill: var(--ink-2); }
  .dv-zl { font-family: var(--font-head); font-weight: 700; font-size: 15px; fill: var(--ink-3); }
  .dv-zl--on { font-weight: 900; fill: var(--sage-ink); }
  .dv-needle-o { stroke: var(--ink); stroke-width: 10; stroke-linecap: round; }
  .dv-needle { stroke: var(--bo); stroke-width: 4; stroke-linecap: round; }
  .dv-hub { fill: var(--bo-fill); stroke: var(--ink); stroke-width: 3.5; }
  .dv-ink { fill: var(--ink); }
  .dv-line { fill: none; stroke: var(--ink); stroke-width: 2.8; stroke-linecap: round; }
  .dv-blush { fill: var(--cheek); opacity: 0.85; }
</style>
