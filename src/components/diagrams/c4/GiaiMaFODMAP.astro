---
/** Giải mã chữ viết tắt FODMAP + cơ chế sinh khí (theo bản tin #15). */
import Diagram from '../primitives/Diagram.astro';
import Flow from '../primitives/Flow.astro';
import Card from '../primitives/Card.astro';
import type { Hue } from '~/lib/types';

const letters: { l: string; word: string; hue: Hue; soft?: boolean }[] = [
  { l: 'F', word: 'Fermentable', hue: 'bo' },
  { l: 'O', word: 'Oligosaccharides', hue: 'dao' },
  { l: 'D', word: 'Disaccharides', hue: 'sage' },
  { l: 'M', word: 'Monosaccharides', hue: 'lav' },
  { l: 'A', word: 'and', hue: 'ngoc', soft: true },
  { l: 'P', word: 'Polyols', hue: 'hong' },
];
---
<Diagram
  title="Giải mã FODMAP"
  icon="tim-kiem"
  hue="bo"
  kicker="Minh họa"
  caption="Chế độ ăn FODMAPs bao gồm các carbohydrate chuỗi ngắn, không được hấp thu tại ruột non, sản sinh khí, gây chướng bụng và đau. Ngược lại, chế độ ăn thấp FODMAPs giúp cải thiện các triệu chứng tiêu hoá trong IBS."
  from={['15-dinh-duong-ibs']}
>
  <div class="fod">
    <ol class="fod__letters" aria-label="FODMAP: Fermentable Oligosaccharides Disaccharides Monosaccharides and Polyols">
      {letters.map((x) => (
        <li class:list={['fod__tile', x.soft && 'fod__tile--soft']} data-hue={x.hue}>
          <span class="fod__l" aria-hidden="true">{x.l}</span>
          <span class="fod__w"><b>{x.word.slice(0, 1)}</b>{x.word.slice(1)}</span>
        </li>
      ))}
    </ol>
    <p class="fod__k">Chế độ ăn FODMAPs bao gồm…</p>
    <Flow
      steps={[
        { icon: 'duong', title: 'Các carbohydrate chuỗi ngắn', hue: 'bo' },
        { icon: 'ruot', title: 'Không được hấp thu tại ruột non', hue: 'dao' },
        { icon: 'hoi-tho', title: 'Sản sinh khí', hue: 'lav' },
        { icon: 'canh-bao', title: 'Gây chướng bụng và đau', hue: 'do' },
      ]}
    />
    <div class="fod__low">
      <Card node={{ icon: 'dung', title: 'Ngược lại, chế độ ăn thấp FODMAPs', text: 'giúp cải thiện các triệu chứng tiêu hoá trong IBS.', hue: 'sage' }} variant="fill" />
    </div>
  </div>
</Diagram>

<style>
  .fod { display: grid; gap: 0.9rem; }
  .fod__letters { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @container (min-width: 480px) { .fod__letters { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .fod__tile { margin: 0; display: grid; justify-items: center; text-align: center; gap: 0.3rem; padding: 0.55rem 0.4rem; border-radius: 14px; background: var(--surface); border: 2px solid var(--ink); box-shadow: 0 3px 0 var(--ink); }
  .fod__tile--soft { border-style: dashed; box-shadow: none; }
  .fod__l { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--h-fill); border: 2px solid var(--h); font-family: var(--font-head); font-weight: 900; font-size: 1.35rem; color: var(--h-ink); }
  .fod__w { font-size: 0.84rem; font-weight: 600; line-height: 1.3; overflow-wrap: break-word; min-width: 0; max-width: 100%; }
  .fod__w b { color: var(--h-ink); font-weight: 900; }
  .fod__k { margin: 0.2rem 0 0; font-family: var(--font-head); font-weight: 800; color: var(--h-ink); }
  .fod__low { display: grid; justify-items: center; }
  .fod__low > :global(.dg-card) { width: min(100%, 460px); }
</style>
