      { time: 'Mỗi ngày', icon: 'can-nang', title: 'Đạt được và duy trì trọng lượng cơ thể khỏe mạnh', text: 'Ngừng hút thuốc; tránh mặc quần áo bó sát vào vùng bụng.', hue: 'ngoc' },
    ]}
  />
</Diagram>
