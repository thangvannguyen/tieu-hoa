---
/** So sánh (bản tin #10, dấu hiệu bổ sung từ #11): buồn ngủ khác với mệt mỏi. Dùng ở bài 10 và bài 11. */
import Diagram from '../primitives/Diagram.astro';
import Compare from '../primitives/Compare.astro';
---
<Diagram
  title="Buồn ngủ khác với mệt mỏi"
  icon="can-bang"
  hue="lav"
  kicker="So sánh"
  caption="Hai khái niệm này thường bị nhầm lẫn. Buổi tối, hãy tự hỏi: “Tôi đang buồn ngủ, hay chỉ đang kiệt sức?”"
  from={['10-ngu-khong-du-hay-roi-loan', '11-bo-cong-cu-bao-ve-giac-ngu']}
>
  <Compare
    vs
    columns={[
      {
        title: 'Buồn ngủ',
        sub: 'xu hướng có thể ngủ thiếp đi, đặc biệt khi ngồi yên hoặc ít bị kích thích',
        icon: 'ngu-trua',
        hue: 'lav',
        items: [
          { icon: 'giuong', text: 'Dấu hiệu: mí mắt nặng, ngáp, khó giữ mắt mở hoặc đầu gật xuống (#11)' },
          { icon: 'hoi-tho', text: 'Người có ngưng thở khi ngủ có thể ngủ gật rất nhanh khi ngồi yên' },
