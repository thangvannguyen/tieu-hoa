        ],
      },
      {
        title: 'Mệt mỏi',
        sub: 'cảm giác thiếu năng lượng, kiệt sức hoặc không muốn hoạt động, nhưng chưa chắc có thể ngủ được',
        icon: 'dong-ho-cat',
        hue: 'dao',
        items: [
          { icon: 'may-stress', text: 'Có thể đi kèm căng thẳng, bồn chồn và đầu óc vẫn hoạt động mạnh (#11)' },
          { icon: 'trang', text: 'Một người mất ngủ có thể cảm thấy rất mệt nhưng không dễ ngủ vào ban ngày' },
          { icon: 'nha', text: 'Khi chỉ mệt nhưng chưa buồn ngủ: thực hiện một hoạt động chuyển tiếp nhẹ nhàng bên ngoài giường ngủ (#11)' },
        ],
      },
    ]}
  />
</Diagram>
