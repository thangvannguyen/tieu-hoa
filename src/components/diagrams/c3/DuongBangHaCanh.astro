---
/**
 * Minh họa (bản tin #11): "đường băng hạ cánh" cho não bộ — 6 bước giảm dần kích thích trong khoảng 30–60 phút
 * trước giờ ngủ dự kiến. Máy bay hạ dần theo đường lượn, mỗi chấm số là một bước (chú giải bên dưới).
 */
import Diagram from '../primitives/Diagram.astro';
import Icon from '~/components/ui/Icon.astro';

const steps = [
  { icon: 'laptop', text: 'Kết thúc các công việc có tính cạnh tranh hoặc gây căng thẳng' },
  { icon: 'nhat-ky', text: 'Viết lại công việc hoặc suy nghĩ còn dang dở cho ngày mai' },
  { icon: 'den-ngu', text: 'Giảm ánh sáng' },
  { icon: 'nuoc', text: 'Vệ sinh cá nhân' },
  { icon: 'sach', text: 'Đọc nội dung nhẹ nhàng hoặc nghe âm thanh thư giãn' },
  { icon: 'giuong', text: 'Lên giường khi buồn ngủ' },
];
// đường lượn hạ cánh: Bézier bậc 3
const P = [[52, 40], [140, 44], [236, 84], [306, 122]] as const;
const bz = (t: number) => {
  const m = 1 - t;
  const k = [m * m * m, 3 * m * m * t, 3 * m * t * t, t * t * t];
  return [0, 1].map((j) => +(k[0] * P[0][j] + k[1] * P[1][j] + k[2] * P[2][j] + k[3] * P[3][j]).toFixed(1));
};
const dots = steps.map((_, i) => bz(0.1 + (i * 0.8) / (steps.length - 1)));
const path = `M${P[0].join(' ')}C${P[1].join(' ')} ${P[2].join(' ')} ${P[3].join(' ')}`;
---
<Diagram
  title="“Đường băng hạ cánh” cho não bộ"
  icon="may-bay"
  hue="lav"
  kicker="Minh họa"
  caption="Bạn không thể chuyển trực tiếp từ chế độ xử lý công việc căng thẳng sang ngủ chỉ trong vài phút. Hãy dành khoảng 30–60 phút trước giờ ngủ dự kiến để giảm dần kích thích. Không cần thực hiện một nghi thức cầu kỳ."
  from={['11-bo-cong-cu-bao-ve-giac-ngu']}
>
  <div class="db">
    <svg class="db__svg" viewBox="0 0 360 160" role="img" aria-label="Một chiếc máy bay hạ cánh dần từ chế độ làm việc xuống đường băng giấc ngủ, qua sáu bước trong khoảng 30 đến 60 phút trước giờ ngủ dự kiến.">
      <path class="db__sky" d="M8 150V20c0-8 6-14 14-14h316c8 0 14 6 14 14v130"></path>
      <path class="db__glide" d={path}></path>
      <g transform="rotate(60 36 38)"><Icon name="may-bay" size={40} x={16} y={18} /></g>
      <text x="262" y="34" class="db__big" text-anchor="middle">30–60 phút</text>
      <text x="262" y="54" class="db__small" text-anchor="middle">giảm dần kích thích</text>
      <text x="14" y="86" class="db__small">chế độ xử lý</text>
      <text x="14" y="103" class="db__small">công việc</text>
      {dots.map(([x, y], i) => (
        <g class="db__dot">
          <circle cx={x} cy={y} r="11"></circle>
          <text x={x} y={y} text-anchor="middle" dominant-baseline="central">{i + 1}</text>
        </g>
      ))}
      <rect class="db__runway" x="250" y="126" width="98" height="14" rx="7"></rect>
      <path class="db__mark" d="M262 133h12M284 133h12M306 133h12M328 133h10"></path>
      <text x="299" y="156" class="db__small db__small--b" text-anchor="middle">giờ ngủ dự kiến</text>
    </svg>

    <ol class="db__steps">
      {steps.map((s, i) => (
        <li>
          <span class="db__num">{i + 1}</span>
          <span class="db__ic"><Icon name={s.icon} size={24} /></span>
          <span class="db__tx">{s.text}</span>
        </li>
      ))}
    </ol>
    <p class="db__sub">
      <span class="db__num db__num--sm">2</span>
      <span>
        <strong>Kỹ thuật “đóng cửa ngày làm việc”</strong> — trước khi ngừng làm việc, hãy thử viết ba dòng:
        <span class="db__q">Hôm nay tôi đã hoàn thành điều gì?</span>
        <span class="db__q">Việc chưa hoàn thành sẽ được xử lý khi nào?</span>
        <span class="db__q">Việc đầu tiên tôi sẽ làm vào ngày mai là gì?</span>
      </span>
    </p>
  </div>
</Diagram>

<style>
  .db { display: grid; gap: 1rem; }
  .db__svg { width: 100%; max-width: 560px; margin: 0 auto; display: block; overflow: visible; color: var(--ink); --ic-fill: var(--lav-fill); }
  .db__sky { fill: var(--surface); stroke: var(--line-2); stroke-width: 2; }
  .db__glide { fill: none; stroke: var(--lav-ink); stroke-width: 3; stroke-dasharray: 2 8; stroke-linecap: round; }
  .db__big { font-family: var(--font-head); font-weight: 900; font-size: 20px; fill: var(--lav-ink); }
  .db__small { font-family: var(--font-head); font-weight: 800; font-size: 14px; fill: var(--ink-2); }
  .db__small--b { fill: var(--ink); }
  .db__dot circle { fill: var(--lav-fill); stroke: var(--ink); stroke-width: 2.6; }
  .db__dot text { font-family: var(--font-head); font-weight: 900; font-size: 13px; fill: var(--ink); }
  .db__runway { fill: var(--line-2); stroke: var(--ink); stroke-width: 3; }
  .db__mark { stroke: var(--surface); stroke-width: 3; stroke-linecap: round; }

  .db__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  @container (min-width: 620px) { .db__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .db__steps li { margin: 0; display: grid; grid-template-columns: auto auto 1fr; gap: 0.5rem; align-items: center; padding: 0.55rem 0.7rem; border-radius: 14px; background: var(--surface); border: 2px solid var(--line-2); }
  .db__num { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--ink); color: var(--bg); font-family: var(--font-head); font-weight: 900; font-size: 0.85rem; }
  .db__ic { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 12px; background: var(--lav-fill); --ic-fill: var(--surface); }
  .db__tx { font-weight: 600; font-size: 0.94rem; line-height: 1.4; }
  .db__sub { display: grid; grid-template-columns: auto 1fr; gap: 0.55rem; align-items: start; margin: 0 !important; padding: 0.65rem 0.8rem; border-radius: 14px; background: var(--bo-fill); font-size: 0.92rem; line-height: 1.5; }
  .db__sub > span:last-child { display: grid; gap: 0.15rem; }
  .db__q::before { content: '· '; font-weight: 900; }
  .db__num--sm { width: 24px; height: 24px; font-size: 0.8rem; }
</style>
