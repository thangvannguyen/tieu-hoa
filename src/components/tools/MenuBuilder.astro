---
/** Thực đơn của tôi (bản tin #13): bảng 5 cột, nạp thực đơn mẫu rồi tự điều chỉnh. */
import Icon from '~/components/ui/Icon.astro';
const id = 'thuc-don-cua-toi';
const mods = import.meta.glob<{ menus: { title: string; rows: Record<string, string>[] }[] }>('/src/data/thuc-don-mau.json', { eager: true, import: 'default' });
const sample = Object.values(mods)[0]?.menus ?? [];
const cols = [
  { id: 'bua', label: 'Bữa' },
  { id: 'mon', label: 'Món ăn' },
  { id: 'thuc_pham', label: 'Thực phẩm' },
  { id: 'khoi_luong', label: 'Khối lượng (g)' },
  { id: 'ghi_chu', label: 'Ghi chú' },
];
---
<bev-menu class="mb" data-key={`tool:${id}`}>
  <script type="application/json" data-sample set:html={JSON.stringify(sample)} />
  <script type="application/json" data-cols set:html={JSON.stringify(cols)} />
  <div class="mb__bar no-print">
    {sample.length > 0 ? (
      <>
        <span>Nạp thực đơn mẫu:</span>
        {sample.map((m, i) => <button type="button" class="btn btn--sm btn--ghost" data-load={i}><Icon name="tai-xuong" size={18} /> {m.title}</button>)}
      </>
    ) : (
      <span class="mb__nosample">Thực đơn mẫu đang được cập nhật — bạn vẫn có thể tự điền.</span>
    )}
  </div>
  <div class="table-scroll">
    <table class="mb__table">
      <thead><tr>{cols.map((c) => <th scope="col">{c.label}</th>)}<th scope="col"><span class="visually-hidden">Xoá dòng</span></th></tr></thead>
      <tbody data-body></tbody>
    </table>
  </div>
  <p class="mb__add no-print"><button type="button" class="btn btn--sm" data-add><Icon name="ke" size={18} /> Thêm dòng</button></p>
</bev-menu>
<script>
  import { read, write, requestPersist } from '~/lib/storage';
  type Row = Record<string, string>;
  type State = { rows: Row[] };
  class BevMenu extends HTMLElement {
    key!: string; state!: State; cols!: { id: string; label: string }[]; sample!: { title: string; rows: Row[] }[];
    connectedCallback() {
      this.key = this.dataset.key!;
      this.cols = JSON.parse(this.querySelector('script[data-cols]')!.textContent!);
      this.sample = JSON.parse(this.querySelector('script[data-sample]')!.textContent!);
      this.load();
      this.querySelector('[data-add]')!.addEventListener('click', () => { this.state.rows.push({}); this.save(); this.render(); });
      this.querySelectorAll<HTMLButtonElement>('[data-load]').forEach((b) => b.addEventListener('click', () => {
        if (this.state.rows.some((r) => Object.values(r).some(Boolean)) && !confirm('Thay bảng hiện tại bằng thực đơn mẫu?')) return;
        this.state.rows = this.sample[Number(b.dataset.load)].rows.map((r) => ({ ...r }));
        this.save(); this.render();
      }));
      (this as any).toolApi = { reload: () => this.load(), csv: () => [this.cols.map((c) => c.label), ...this.state.rows.map((r) => this.cols.map((c) => r[c.id] ?? ''))] };
    }
    load() { this.state = read<State>(this.key, { rows: [{}, {}, {}] }); this.state.rows ??= []; this.render(); }
    save() { write(this.key, this.state); requestPersist(); }
    render() {
      const body = this.querySelector<HTMLTableSectionElement>('[data-body]')!;
      body.replaceChildren();
      this.state.rows.forEach((row, i) => {
        const tr = body.insertRow();
        for (const c of this.cols) {
          const td = tr.insertCell();
          const ta = document.createElement('textarea');
          ta.rows = 1;
          ta.value = row[c.id] ?? '';
          ta.setAttribute('aria-label', `${c.label}, dòng ${i + 1}`);
          ta.addEventListener('input', () => { row[c.id] = ta.value; this.save(); });
          td.append(ta);
        }
        const td = tr.insertCell();
        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'mb__del';
        del.textContent = '×';
        del.setAttribute('aria-label', `Xoá dòng ${i + 1}`);
        del.addEventListener('click', () => { this.state.rows.splice(i, 1); this.save(); this.render(); });
        td.append(del);
      });
    }
  }
  customElements.define('bev-menu', BevMenu);
</script>
<style>
  .mb__bar { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-bottom: 0.8rem; font-weight: 600; }
  .mb__nosample { color: var(--ink-2); font-weight: 500; }
  .mb__table { width: 100%; min-width: 680px; border-collapse: separate; border-spacing: 0; background: var(--surface); border: 2px solid var(--ink); border-radius: var(--radius); overflow: hidden; }
  .mb__table th { background: var(--h-fill); font-family: var(--font-head); text-align: left; padding: 0.55rem 0.6rem; font-size: 0.92rem; border-bottom: 2px solid var(--ink); }
  .mb__table :global(td) { border-bottom: 1.5px solid var(--line); padding: 0.2rem; vertical-align: top; }
  .mb__table :global(textarea) { width: 100%; min-height: 40px; padding: 0.45rem 0.5rem; border: 2px solid transparent; border-radius: 10px; background: transparent; resize: vertical; line-height: 1.4; }
  .mb__table :global(textarea:focus) { outline: none; border-color: var(--ink); background: var(--bg); }
  .mb__table :global(.mb__del) { width: 36px; height: 36px; border-radius: 10px; border: 2px dashed var(--line-2); background: transparent; color: var(--ink-3); cursor: pointer; font-size: 1.1rem; }
  .mb__add { margin-top: 0.8rem; }
</style>
