---
import { render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/ui/Icon.astro';
import BeBung from '~/components/ui/BeBung.astro';
import KeyPoints from '~/components/lesson/KeyPoints.astro';
import Toc from '~/components/lesson/Toc.astro';
import Reflection from '~/components/lesson/Reflection.astro';
import Quiz from '~/components/lesson/Quiz.astro';
import MarkDone from '~/components/lesson/MarkDone.astro';
import LessonNav from '~/components/lesson/LessonNav.astro';
import SignOff from '~/components/lesson/SignOff.astro';
import ToolLink from '~/components/lesson/ToolLink.astro';
import { mdxComponents } from '~/components/mdx';
import { getLessons, lessonLabel, readingMinutes, chapterOf, type Lesson } from '~/lib/lessons';
import { authors } from '~/data/authors';
import { quizzes } from '~/lib/data';
import { url } from '~/lib/url';

export async function getStaticPaths() {
  const lessons = await getLessons();
  return lessons.map((lesson, i) => ({
    params: { id: lesson.id },
    props: { lesson, prev: lessons[i - 1], next: lessons[i + 1], all: lessons },
  }));
}

interface Props { lesson: Lesson; prev?: Lesson; next?: Lesson; all: Lesson[] }
const { lesson, prev, next, all } = Astro.props;
const d = lesson.data;
const { Content, headings } = await render(lesson);
const chapter = chapterOf(lesson);
const minutes = readingMinutes(lesson.body);
const quiz = quizzes[lesson.id];
const related = d.related.map((id) => all.find((l) => l.id === id)).filter(Boolean) as Lesson[];
const label = lessonLabel(lesson);
// công cụ đã có thẻ <ToolLink> ngay trong bài thì không lặp lại ở cuối
const endTools = d.tools.filter((t) => !new RegExp(`<ToolLink[^>]*tool=["']${t}["']`).test(lesson.body ?? ''));
---
<BaseLayout title={d.title} description={d.summary} hue={chapter.hue}>
  <article class="lesson" data-pagefind-body data-pagefind-filter={`chuong:${chapter.title}`}>
    <header class="hero" data-hue={chapter.hue}>
      <div class="container hero__in">
        <div class="hero__tx">
          <p class="hero__meta">
            <a class="chip" href={url(`/chuong/${chapter.id}/`)}><Icon name={chapter.icon} size={18} /> {chapter.title}</a>
            {d.kind === 'bai-them' ? <span class="chip chip--ink" data-pagefind-meta="kicker">{d.published ? `Đăng ${d.published.split(' ')[0]}` : 'Bài đọc thêm'}</span> : <span class="chip chip--ink" data-pagefind-meta="kicker">{label}</span>}
          </p>
          <h1 data-pagefind-meta="title">{d.title}</h1>
          {d.subtitle && <p class="hero__sub">{d.subtitle}</p>}
          <p class="hero__by">
            <span><Icon name="bac-si" size={20} /> {d.authors.map((a) => authors[a].short).join(' & ')}</span>
            <span><Icon name="dong-ho" size={20} /> {minutes} phút đọc</span>
            {d.published && <span><Icon name="lich" size={20} /> {d.published}</span>}
          </p>
        </div>
        <div class="hero__art" aria-hidden="true">
          <span class="hero__blob"></span>
          <BeBung mood={d.mascot} size={150} />
          <span class="hero__sticker"><Icon name={d.icon} size={52} /></span>
        </div>
      </div>
    </header>

    <div class="container layout">
      <aside class="side no-print" data-pagefind-ignore>
        <Toc headings={headings} />
      </aside>
      <div class="main">
        <KeyPoints points={d.keyPoints} />
        <div class="prose">
          <Content components={mdxComponents} />
        </div>

        {endTools.length > 0 && (
          <section class="tools" data-pagefind-ignore>
            {endTools.map((t) => <ToolLink tool={t} />)}
          </section>
        )}

        <SignOff lines={d.signoff} />

        {d.reflection.length > 0 && <Reflection lesson={lesson.id} questions={d.reflection} />}
        {quiz && <div data-pagefind-ignore><Quiz quiz={quiz} /></div>}

        <div data-pagefind-ignore>
          <MarkDone lesson={lesson.id} />
          {related.length > 0 && (
            <section class="rel" aria-label="Bài liên quan">
              <h2 class="rel__t">Bài liên quan</h2>
              <ul>
                {related.map((r) => {
                  const c = chapterOf(r);
                  return (
                    <li data-hue={c.hue}>
                      <a href={url(`/bai/${r.id}/`)}>
                        <Icon name={r.data.icon} size={30} />
                        <span><span class="rel__k">{lessonLabel(r)}</span><span class="rel__n">{r.data.title}</span></span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          )}
          <LessonNav prev={prev} next={next} />
          {d.source && <p class="src"><Icon name="nhan" size={18} /> <span>Nguồn: file gốc “{d.source.file.split('/').pop()}” trong thư mục <em>tai-lieu-goc</em> — tiêu đề gốc: “{d.titleOriginal}”.</span></p>}
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; background: linear-gradient(180deg, var(--h-fill), var(--bg)); border-bottom: 2px solid var(--line); }
  .hero__in { display: grid; gap: 1rem; align-items: center; padding: 2.2rem 0 2rem; }
  @media (min-width: 820px) { .hero__in { grid-template-columns: 1fr auto; padding: 3rem 0 2.6rem; } }
  .hero__meta { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 0.8rem; }
  .hero__meta a.chip { text-decoration: none; background: var(--surface); border: 2px solid var(--h); }
  .chip--ink { background: var(--ink); color: var(--bg); }
  h1 { margin: 0 0 0.5rem; max-width: 22ch; }
  .hero__sub { font-size: 1.1rem; color: var(--ink-2); max-width: 46ch; margin: 0 0 0.8rem; }
  .hero__by { display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; margin: 0; color: var(--ink-2); font-size: 0.93rem; }
  .hero__by span { display: inline-flex; align-items: center; gap: 0.35rem; --ic-fill: var(--surface); }
  .hero__art { position: relative; display: none; width: 220px; height: 190px; place-items: center; }
  @media (min-width: 820px) { .hero__art { display: grid; } }
  .hero__blob { position: absolute; inset: 10px 0 0 20px; border-radius: 46% 54% 42% 58% / 52% 44% 56% 48%; background: var(--h); opacity: 0.35; }
  .hero__art :global(.bebung) { position: relative; }
  .hero__sticker { position: absolute; right: 0; top: 6px; display: grid; place-items: center; width: 70px; height: 70px; border-radius: 22px; background: var(--surface); border: 2px solid var(--edge); box-shadow: 0 3px 0 var(--edge-shadow); transform: rotate(8deg); --ic-fill: var(--h-fill); }

  .layout { display: grid; gap: 2rem; padding-top: 2rem; }
  @media (min-width: 1100px) {
    .layout { grid-template-columns: 15rem minmax(0, 46rem); justify-content: center; gap: 3rem; }
    .side { order: 0; }
    .side :global(.toc) { position: sticky; top: 84px; max-height: calc(100vh - 100px); overflow: auto; }
  }
  .main { min-width: 0; max-width: 46rem; width: 100%; margin-inline: auto; }
  .main > :global(.kp) { margin-bottom: 2rem; }
  .prose { max-width: none; }
  .rel { margin: 2rem 0 0; }
  .rel__t { font-size: 1.25rem; }
  .rel ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); }
  .rel li { margin: 0; }
  .rel a { display: flex; gap: 0.7rem; align-items: center; padding: 0.8rem 0.9rem; border-radius: var(--radius); background: var(--h-fill); color: var(--ink); text-decoration: none; border: 2px solid transparent; --ic-fill: var(--surface); }
  .rel a:hover { border-color: var(--edge); }
  .rel__k { display: block; font-size: 0.75rem; font-weight: 700; color: var(--h-ink); text-transform: uppercase; letter-spacing: 0.04em; }
  .rel__n { display: block; font-family: var(--font-head); font-weight: 800; line-height: 1.3; }
  .src { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin: 2rem 0 0; font-size: 0.82rem; color: var(--ink-3); }

</style>
