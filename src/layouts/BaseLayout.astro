---
// Chỉ tải 2 độ đậm (400, 700) của Be Vietnam Pro + Nunito variable để trang nhẹ; nghiêng do trình duyệt tự tạo.
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/700.css';
import '@fontsource-variable/nunito/index.css';
import nunitoVi from '@fontsource-variable/nunito/files/nunito-vietnamese-wght-normal.woff2?url';
import nunitoLatin from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import bodyVi from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-vietnamese-400-normal.woff2?url';
import bodyLatin from '@fontsource/be-vietnam-pro/files/be-vietnam-pro-latin-400-normal.woff2?url';
import '~/styles/global.css';
import Header from '~/components/ui/Header.astro';
import Footer from '~/components/ui/Footer.astro';
import SearchDialog from '~/components/ui/SearchDialog.astro';
import SettingsDialog from '~/components/ui/SettingsDialog.astro';
import ScrollTop from '~/components/ui/ScrollTop.astro';
import BottomBar from '~/components/ui/BottomBar.astro';
import type { Hue } from '~/lib/types';
import { url } from '~/lib/url';

interface Props {
  title: string;
  description?: string;
  hue?: Hue;
  /** bỏ trang này khỏi chỉ mục tìm kiếm */
  noindex?: boolean;
}
const { title, description = 'Web học tập từ chuỗi bản tin y khoa "Bụng Êm, Việc Ổn" của BS. Phan Thị Lan Viên — giữ ổn định hệ tiêu hóa trong đời sống bận rộn.', hue = 'dao', noindex = false } = Astro.props;
const siteName = 'Bụng Êm, Việc Ổn';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="vi" data-hue={hue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    {[nunitoVi, nunitoLatin, bodyVi, bodyLatin].map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <meta name="theme-color" content="#fff9f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1714" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    {noindex && <meta name="robots" content="noindex" />}
    <script is:inline>
      (function () {
        try {
          var p = JSON.parse(localStorage.getItem('bev:v1:prefs') || '{}');
          if (p.theme === 'dark' || p.theme === 'light') document.documentElement.dataset.theme = p.theme;
          if (p.style === 'de-doc' || p.style === 'don-gian' || p.style === 'tuong-phan') document.documentElement.dataset.style = p.style;
          if (p.size === 'nho' || p.size === 'to') document.documentElement.dataset.size = p.size;
          if (p.bottomBar === false) document.documentElement.dataset.bottombar = 'off';
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#noi-dung">Bỏ qua, tới nội dung chính</a>
    <Header />
    <main id="noi-dung" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SearchDialog />
    <SettingsDialog />
    <ScrollTop />
    <BottomBar />
  </body>
</html>

<style>
  main { display: block; min-height: 60vh; outline: none; }
</style>
